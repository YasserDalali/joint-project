# Copy to `.env` in the repo root (never commit `.env`).
#
# SQL Server SA password must meet policy: at least 8 characters and
# characters from three of: uppercase, lowercase, digits, symbols.
#
# Use single quotes around passwords that contain $ or ! so both
# `docker compose` and `source .env` in shell scripts behave correctly.

SA_PASSWORD='FinRisk_Dev_8x!'
DB_PASSWORD='FinRisk_Dev_8x!'

# JDBC (Spring / DatabaseConnection.java reads these env vars)
DB_HOST=localhost
DB_PORT=1433
DB_NAME=FinRiskDB
DB_USER=sa

# Integration tests use FinRiskDB_Test (see IntegrationTestSupport.java)
DB_TEST_NAME=FinRiskDB_Test
