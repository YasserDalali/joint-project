# SQL Server (docker-compose sqlserver service)
SA_PASSWORD=Your_strong_Password123!

# JDBC (application uses env vars — default FinRiskDB)
# For local integration tests against FinRiskDB_Test, pass -DDB_NAME=FinRiskDB_Test
# The bundled SQL Server container uses the `sa` login created from SA_PASSWORD.
DB_HOST=localhost
DB_PORT=1433
DB_NAME=FinRiskDB
DB_USER=sa
DB_PASSWORD=Your_strong_Password123!

DB_TEST_NAME=FinRiskDB_Test
